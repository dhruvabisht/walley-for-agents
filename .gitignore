# ============ SECRETS: never commit ============
# Stripe Projects writes every provider key here
# Stripe Projects state, vault and cache (may hold credentials) - ignore the whole folder
# Vercel link + local tokens
.vercel
# Keys / certs
*.pem
*.key
# Local agent settings
.claude/settings.local.json

# ============ Next.js ============
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Browser test artifacts
.playwright-mcp/

.projects/cache
.projects/vault
.projects/state.test.json
.projects/state.local.test.json
.env
.env.*
!.env.example

# Walley: ignore Stripe Projects state except state.json (stack manifest, no credentials;
# the projects.dev submission checks for it). Tools may rewrite the block above.
.projects/*
!.projects/state.json
.env
.env.*
!.env.example
